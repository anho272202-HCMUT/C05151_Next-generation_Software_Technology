# LLM backend: ollama (local, default) | anthropic | openai | mock (offline tests)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Only for hosted providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Guardrail on all untrusted inputs; 0 disables it (ablation only)
CRITIC_GUARDRAIL=1
