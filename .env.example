# LLM backend: ollama (local, default) | anthropic | openai | mock (offline tests)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Only for hosted providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Guardrail on all untrusted inputs; 0 disables it (ablation only)
CRITIC_GUARDRAIL=1
# Defence layers (prompt-injection threat model). CRITIC_GUARDRAIL is the master switch; each layer can be overridden for ablations:
# L1 hidden-text removal, L2 sanitiser, L3 prompt spotlighting. L5 (epistemic rule) is off by default: its effect is not established.
# CRITIC_L1=1
# CRITIC_L2=1
# CRITIC_L3=1
# CRITIC_L5=0
