# LLM backend: ollama (local, default) | anthropic | openai | mock (offline tests)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# Context window of the Ollama model (default 8192). Raise it together with CRITIC_EVIDENCE_TOKENS on a GPU,
# e.g. OLLAMA_NUM_CTX=16384 for a 14B model on a 16 GB T4 (see scripts/colab_calibrate.ipynb)
# OLLAMA_NUM_CTX=8192
# Thinking models (qwen3, gpt-oss): OLLAMA_THINK = low|medium|high (gpt-oss) or true|false; thinking gets
# OLLAMA_THINK_TOKENS on top of each answer's budget. OLLAMA_JSON_FORMAT=0 drops Ollama's JSON mode for such a model.
# OLLAMA_THINK=
# OLLAMA_THINK_TOKENS=4096
# OLLAMA_JSON_FORMAT=1
EMBED_MODEL=nomic-embed-text
# Only for hosted providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Hosted example (stronger reviews and paper scores): LLM_PROVIDER=anthropic, LLM_MODEL=claude-opus-5-5.
# Effort of hosted reasoning models: low | medium | high | xhigh | max (empty = provider default)
# LLM_EFFORT=high
# Hosted providers get larger budgets automatically (8000 evidence tokens, 8 hits per query, 16000 opening chars);
# set these to override, e.g. to compare with the local-model budgets (1800 / 4 / 4000)
# CRITIC_EVIDENCE_TOKENS=8000
# CRITIC_SEARCH_K=8
# CRITIC_FIRST_PAGES_CHARS=16000
# Meta-reviewer: overall 1-10 paper score (0 disables it); judges run at temperature 0 unless overridden
# CRITIC_PAPER_SCORE=1
# CRITIC_JUDGE_TEMPERATURE=0
# Guardrail on all untrusted inputs; 0 disables it (ablation only)
CRITIC_GUARDRAIL=1
# Defence layers (prompt-injection threat model). CRITIC_GUARDRAIL is the master switch; each layer can be overridden for ablations:
# L1 hidden-text removal, L2 sanitiser, L3 prompt spotlighting. L5 (epistemic rule) is off by default: its effect is not established.
# CRITIC_L1=1
# CRITIC_L2=1
# CRITIC_L3=1
# CRITIC_L5=0
